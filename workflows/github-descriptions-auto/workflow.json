{
  "name": "GitHub — descriptions auto",
  "nodes": [
    {
      "id": "11111111-aaaa-4bbb-8ccc-000000000001",
      "name": "Horloge quotidienne (07h45)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "position": [
        0,
