      "typeVersion": 1.2
    },
    {
      "id": "11111111-aaaa-4bbb-8ccc-000000000002",
      "name": "GitHub — liste des repos",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        220,
        0
      ],
      "parameters": {
        "url": "https://api.github.com/user/repos?per_page=100&sort=pushed&affiliation=owner,collaborator",
        "options": {},
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer GITHUB_PAT_MASKED"
            },
            {
              "name": "User-Agent",
              "value": "n8n-desc-auto"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            }
          ]
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "11111111-aaaa-4bbb-8ccc-000000000003",
      "name": "Filtre — sans description",
      "type": "n8n-nodes-base.code",
      "position": [
        440,
        0
      ],
      "parameters": {
        "jsCode": "const repos = $input.all().map(i => i.json);\nconst cibles = repos.filter(r => !r.archived && !r.description && !r.fork);\nreturn cibles.map(r => ({\n  json: {\n    name: r.name,\n    full_name: r.full_name,\n    language: r.language || \"\",\n    prompt: \"Tu écris des descriptions courtes de projets GitHub. Exemples du style attendu :\\n- « Suivi de chantier pour petites équipes »\\n- « Portfolio de photographie argentique »\\n- « Veille automatique des prix concurrents »\\nProjet à décrire : « \" + r.name + \" » (langage : \" + (r.language || \"inconnu\") + \"). Écris une description en français, une seule ligne, maximum 60 caractères, sans guillemets. Réponds uniquement par la description, rien d'autre.\"\n  }\n}));"
      },
      "typeVersion": 2
    },
    {
      "id": "11111111-aaaa-4bbb-8ccc-000000000004",
      "name": "Ollama — génère la description",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        660,
        0
      ],
      "parameters": {
        "url": "http://ollama:11434/api/generate",
        "body": "={{ JSON.stringify({ model: 'qwen2.5:7b', stream: false, options: { temperature: 0.2 }, prompt: $json.prompt }) }}",
        "method": "POST",
        "options": {
          "timeout": 300000
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json"
      },
      "typeVersion": 4.2
    },
    {
      "id": "11111111-aaaa-4bbb-8ccc-000000000005",
      "name": "Nettoie la description",
      "type": "n8n-nodes-base.code",
      "position": [
        880,
        0
      ],
      "parameters": {
        "jsCode": "// Mode par item : $('Filtre').item résout le BON item (fix pairing du 16/09)\nconst src = $('Filtre — sans description').item.json;\nlet d = (($json.response || '').trim().split('\\n').filter(Boolean)[0] || '').trim();\nd = d.replace(/^[\\-\\*«»\"'\\s]+/, '').replace(/[«»\"'\\s]+$/, '').replace(/\\*\\*/g, '').trim();\nif (d.length > 80) d = d.slice(0, 77).trim() + '…';\nif (!d) d = 'Projet ' + src.name + (src.language ? ' (' + src.language + ')' : '');\nreturn { json: { full_name: src.full_name, name: src.name, description: d } };",
        "mode": "runOnceForEachItem"
      },
      "typeVersion": 2,
      "mode": "runOnceForEachItem"
    },
    {
      "id": "11111111-aaaa-4bbb-8ccc-000000000006",
      "name": "GitHub — ajoute la description",
      "type": "n8n-nodes-base.httpRequest",
      "position": [
        1100,
        0
      ],
      "parameters": {
        "url": "=https://api.github.com/repos/{{ $json.full_name }}",
        "body": "={{ JSON.stringify({ description: $json.description }) }}",
        "method": "PATCH",
        "options": {},
        "sendBody": true,
        "contentType": "raw",
        "sendHeaders": true,
        "rawContentType": "application/json",
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "Bearer GITHUB_PAT_MASKED"
            },
            {
              "name": "User-Agent",
              "value": "n8n-desc-auto"
            },
            {
              "name": "X-GitHub-Api-Version",
              "value": "2022-11-28"
            },
            {
              "name": "Accept",
              "value": "application/vnd.github+json"
            }
          ]
        }
      },
      "typeVersion": 4.2
    },
    {
      "id": "11111111-aaaa-4bbb-8ccc-000000000007",
      "name": "Récapitule",
      "type": "n8n-nodes-base.code",
      "position": [
        1320,
        0
      ],
      "parameters": {
        "jsCode": "const items = $input.all();\nif (!items.length) return [];\nconst lignes = items.map(i => '- ' + i.json.name + ' : ' + i.json.description).join('\\n');\nreturn [{ json: { text: '🏷️ Descriptions GitHub ajoutées (' + items.length + ') :\\n' + lignes } }];"
      },
      "typeVersion": 2
    },
    {
      "id": "11111111-aaaa-4bbb-8ccc-000000000008",
      "name": "Telegram — récap",
      "type": "n8n-nodes-base.telegram",
      "position": [
        1540,
        0
      ],
      "parameters": {
        "text": "={{ $json.text }}",
        "chatId": "8634051625",
        "additionalFields": {
