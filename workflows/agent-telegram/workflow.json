  {
    "id": "461034e7-3c49-4f5d-b213-89a619a6b744",
    "name": "Prépare le résumé",
    "type": "n8n-nodes-base.code",
    "position": [
      0,
      400
    ],
    "parameters": {
      "jsCode": "const repos = $input.all().map(i => i.json);\nconst aujourdhui = Date.now();\nconst lignes = repos.map(r => {\n  const jours = Math.floor((aujourdhui - new Date(r.pushed_at).getTime()) / 86400000);\n  const age = jours <= 0 ? \"aujourd'hui\" : jours === 1 ? \"hier\" : `il y a ${jours} jours`;\n  return `- ${r.name} (${r.private ? \"privé\" : \"public\"}) — dernier push ${age}${r.description ? \" — \" + r.description : \"\"}`;\n});\nreturn [{ json: { resume: `Repos GitHub d'Emmanuel (total : ${repos.length}) :\\n\\n${lignes.join(\"\\n\")}` } }];"
    },
    "typeVersion": 2
  }
]