            }
          ]
        },
        "includeOtherFields": true,
        "options": {}
      },
      "id": "1a2b3c4d-0002-4000-8000-000000000002",
      "name": "Config (PAT GitHub)",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        -180,
        0
      ],
      "notes": "PAT GitHub stocké ici (demande utilisateur : ne pas avoir à le redonner à chaque session). Visible uniquement dans n8n, chiffré au repos de n8n. NE PAS committer ce workflow avec le vrai token."
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "leftValue": "={{ $json.headers['x-auth-token'] }}",
              "rightValue": "={{ $json.github_token }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "1a2b3c4d-0003-4000-8000-000000000003",
      "name": "Token valide ?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        40,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const body = $json.body || {};\nconst token = $json.github_token;\n// base64 + single-quote wrapping: immunisé shell, même pour les champs vides\nconst b64 = (s) => `'${Buffer.from(String(s ?? ''), 'utf8').toString('base64')}'`;\nconst cmd = [\n  '/projects/scripts/github-push.sh',\n  b64(body.repo),\n  b64(body.path),\n  b64(body.message),\n  b64(body.branch),\n  b64(token),\n  b64(body.private)\n].join(' ');\n// capture du code de sortie pour toujours répondre au webhook\nreturn [{ json: { cmd: cmd + ' 2>&1; echo \"EXIT:$?\"' } }];"
      },
      "id": "1a2b3c4d-0004-4000-8000-000000000004",
      "name": "Prépare les arguments",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        260,
        -80
      ]
    },
    {
      "parameters": {
        "command": "={{ $json.cmd }}",
        "executeOnce": false
      },
      "id": "1a2b3c4d-0005-4000-8000-000000000005",
      "name": "Push vers GitHub",
      "type": "n8n-nodes-base.executeCommand",
